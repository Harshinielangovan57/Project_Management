PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Set DB_DIALECT=postgres to use PostgreSQL
# Set DB_DIALECT=sqlite for zero-config local development
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Optional direct PostgreSQL connection URL (e.g. Neon, Supabase, Render, Railway, AWS RDS)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/project_management

# JWT Secret
JWT_SECRET=super_secret_jwt_project_management_token_key_2026_secure
JWT_EXPIRES_IN=7d
